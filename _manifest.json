{
  "manifest_version": 2,
  "id": "YukiSakiko.content_understanding_plugin",
  "name": "麦麦视频内容理解插件（B站/抖音）",
  "version": "2.1.1",
  "description": "自动识别聊天中的B站与抖音视频链接/分享，获取视频信息、高光片段、章节要点与官方AI总结并附加到上下文，辅助麦麦更好地参与聊天",
  "author": {
    "name": "YukiSakiko",
    "url": "https://github.com/YukiSakiko"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/YukiSakiko/content_understanding_plugin"
  },
  "host_application": {
    "min_version": "0.10.0",
    "max_version": "1.14.5"
  },
  "sdk": {
    "min_version": "2.3.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "bilibili-api-python",
      "version_spec": ">=17.4.0"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    },
    {
      "type": "python_package",
      "name": "qrcode",
      "version_spec": ">=8.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
